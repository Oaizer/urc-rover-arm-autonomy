<?xml version="1.0"?>
<package format="3">
  <name>urc_autonomy</name><version>0.1.0</version>
  <description>Arm motion supervision, multi-view tag registration and hover mission.</description>
  <maintainer email="team@example.com">URC team</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>urc_interfaces</exec_depend>
  <exec_depend>urc_kinematics</exec_depend><exec_depend>urc_perception</exec_depend>
  <exec_depend>control_msgs</exec_depend><exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend><exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
