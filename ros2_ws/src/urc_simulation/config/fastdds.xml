<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>urc_local_shm</transport_id>
      <type>SHM</type>
      <!-- A 640x480 BGR frame is 921600 bytes before serialization.
           Keep space for multiple in-flight images and readers. -->
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>urc_local_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="urc_local_simulation" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>urc_local_shm</transport_id>
        <transport_id>urc_local_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
